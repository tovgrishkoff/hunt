# База данных для Бали (отдельная!)
POSTGRES_DB=telegram_promotion_bali
POSTGRES_USER=telegram_user_bali
POSTGRES_PASSWORD=telegram_password_bali
POSTGRES_PORT=5438

# OpenAI API для секретаря
OPENAI_API_KEY=your_openai_key_here

# Режим «только ретрит»: постер шлёт только туры (Бали, Индия, Кайлас), без недвижимости/услуг
# true = только ретрит (по умолчанию сегодня), false = обычный микс
RETREAT_ONLY_MODE=true
