# ==========================================
# 🌴 ПРОЕКТ: BALI (Работает с базой 5438)
# ==========================================
# Установка: crontab crontab.bali
# Или добавьте содержимое в существующий crontab: crontab -e

# 1. Разведка (Scout) - Каждые 6 часов в 00 минут
0 */6 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec telegram-bali-account-manager python3 /app/services/account-manager/scout.py bali >> data/bali/logs/scout_cron.log 2>&1

# 2. Вступление (Joiner) - Каждые 2 часа в 15 минут (даем время после разведки)
15 */2 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec telegram-bali-account-manager python3 /app/services/account-manager/smart_joiner.py bali 5 >> data/bali/logs/joiner_cron.log 2>&1

# 3. Постинг (Marketer) - по Asia/Jakarta: 08:00, 12:00, 15:00, 18:00
#    При сервере в UTC: 08:00 JKT=01:00 UTC, 12:00 JKT=05:00, 15:00 JKT=08:00, 18:00 JKT=11:00
#    Если сервер в другом поясе — скорректируйте часы (JKT = UTC+7)
0 1,5,8,11 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec telegram-bali-marketer python3 /app/services/marketer/poster.py bali 20 >> data/bali/logs/poster_cron.log 2>&1
