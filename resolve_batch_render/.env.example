# Trial-режим помощник (без автопоста)
TZ=Asia/Makassar

# Путь к SQLite базе очереди
UPLOAD_DB_PATH=output/upload_queue.sqlite3

# Окно публикаций по Москве (можно переопределить флагом --window)
UPLOAD_WINDOW=19:00-22:30
UPLOAD_COUNT_PER_DAY=5

# Фиксированные слоты (утро/обед/вечер) для команды plan-slots
UPLOAD_TIMES=09:00,13:00,19:00
UPLOAD_YT_TIMES=10:00,14:00,20:00

# Случайное время в окнах (каждый день своё, не всегда 09:00/13:00/19:00)
# UPLOAD_RANDOM_SLOTS=1
# UPLOAD_RANDOM_WINDOWS=08:15-10:30,12:00-14:30,18:00-21:00
# UPLOAD_YT_RANDOM_OFFSET_MIN=60

# Автоподхват новых .mov в output/reels (ingest + schedule), сек. 0 = выкл.
# AUTOPOST_WATCH_INTERVAL_SEC=600

# Подпись IG из транскрипта (Whisper + OpenAI), не из texts_kailas.csv
# INGEST_AI_CAPTION_REGEX=^copy_
# INGEST_AI_SCENARIO=bali
# INGEST_TRANSCRIPT_DIR=output/transcripts

# Caption
CAPTION_SUFFIX=\n\nНапиши «КАЙЛАС»

# --- Instagram caption formatting ---
# Добавить блок ссылок (как в YouTube description)
# IG_ADD_BRAND_LINKS=1
# Доп. суффикс для IG (если не задан, используется CAPTION_SUFFIX)
# IG_CAPTION_SUFFIX=\n\nНапиши «КАЙЛАС»
# Хэштеги одной строкой (опционально)
# IG_HASHTAGS=#кайлас #путь #bali
#
# Источник базового текста из texts_kailas.csv для IG (и опционально колонка short_text):
# auto | full_text | short_text | first_block
# auto = short_text если заполнен, иначе первый абзац full_text (до пустой строки), иначе весь full_text
# IG_CAPTION_BASE=auto

# --- Instagram API with Instagram Login (автопостинг) ---
# Instagram professional account id (IG_ID), токен IGAA... (желательно long-lived)
# IG_USER_ID=90010177253934
# IG_ACCESS_TOKEN=IGAA...
# IG_USERNAME=grishkoff
# IG_API_VERSION=v25.0
#
# Прокси (опционально)
# IG_PROXY=http://user:pass@host:port
# IG_MAX_ATTEMPTS=5
#
# Для публикации Reels Instagram должен скачать видео по публичному URL.
# Если у тебя видео лежит локально на сервере, подними статику (nginx/Caddy)
# и задай базовый URL + корень, относительно которого строится относительный путь.
# MEDIA_BASE_URL=https://your-domain.com
# MEDIA_PUBLIC_ROOT=/path/to/resolve_batch_render

# --- Notion (импорт очереди) ---
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_STATUS_PROP=Status
# NOTION_STATUS_READY=Ready
# NOTION_CAPTION_PROP=Caption
# NOTION_VIDEO_URL_PROP=VideoURL
# NOTION_REEL_ID_PROP=ReelID
# NOTION_SCHEDULED_AT_PROP=ScheduledAt

# --- Notion (отчёт о загрузке/публикации) ---
# Эти поля должны существовать в той же базе (или назови их как у тебя).
# NOTION_REPORT_TITLE_PROP=Ролик
# NOTION_REPORT_STATUS_PROP=Статус
# NOTION_REPORT_STATUS_UPLOADED=Готов к публикации
# NOTION_REPORT_STATUS_PUBLISHING=Публикуется
# NOTION_REPORT_STATUS_POSTED=Опубликовано
# NOTION_REPORT_STATUS_ERROR=Ошибка
# NOTION_REPORT_R2_KEY_PROP=Файл видео
# NOTION_REPORT_R2_URL_PROP=Источник (R2)
# NOTION_REPORT_POST_URL_PROP=URL публикации
# NOTION_REPORT_POST_ID_PROP=ID публикации
# NOTION_REPORT_CONTAINER_ID_PROP=Container ID
# NOTION_REPORT_LAST_API_PROP=Последний ответ API
# NOTION_REPORT_ATTEMPTS_PROP=Попыток
# NOTION_REPORT_ERROR_PROP=Ошибка
# NOTION_REPORT_CAPTION_PROP=Описание
# NOTION_REPORT_SCHEDULED_PROP=Запланировано на
# NOTION_REPORT_PUBLISHED_PROP=Дата публикации

# --- Cloudflare R2 (хранение видео для Instagram) ---
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=your-bucket
#
# Публичная база для отдачи файлов (ВАЖНО): либо Public bucket URL, либо кастомный домен.
# Например: https://cdn.your-domain.com
# R2_PUBLIC_BASE_URL=https://cdn.your-domain.com
#
# Префикс внутри бакета
# R2_PREFIX=instagram
#
# Автозагрузка в R2 из autopost, если video_url пустой
# R2_AUTUPLOAD=1
#
# Удалять объект из R2 после успешной публикации
# R2_DELETE_AFTER_POST=1

# --- Локальное хранение видео (на сервере) ---
# Удалять локальный файл (output/reels/*.mov) после успешного crosspost (IG+YT)
# LOCAL_DELETE_AFTER_POST=1
# Разрешённый корень, внутри которого можно удалять файлы
# LOCAL_MEDIA_ROOT=/path/to/resolve_batch_render

# --- Pinterest (video pins) ---
# Trial «Создать маркер» = только read (pins:read). Для заливки — OAuth (scripts/pinterest_oauth.sh).
# PINTEREST_APP_ID=1568734
# PINTEREST_APP_SECRET=...   # секретный ключ приложения
# PINTEREST_REDIRECT_URI=http://localhost:8765/
# PINTEREST_ACCESS_TOKEN=    # из pinterest-oauth-token
# PINTEREST_REFRESH_TOKEN=   # для авто-обновления (позже)
# PINTEREST_BOARD_ID=        # id доски REELS (pinterest-boards)
# UPLOAD_PINTEREST_TIMES=11:00,15:00,21:00
# PINTEREST_DEFAULT_LINK=https://www.instagram.com/grishkoff/
# Trial / «Ограниченная рабочая среда» → sandbox API (по умолчанию при PINTEREST_SANDBOX=1)
# PINTEREST_SANDBOX=1
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com
# ID доски ≠ App ID. Список: python -m uploader.main pinterest-boards
# PINTEREST_COVER_KEY_FRAME_SEC=1
# PINTEREST_MEDIA_POLL_SEC=300
# PINTEREST_MAX_ATTEMPTS=3

# --- YouTube: второй канал (Семь на семь) ---
# BRAND_YOUTUBE_7X7=https://www.youtube.com/@7x7.expedition
# YOUTUBE_7X7_TOKEN_PATH=youtube_shorts_uploader/token_7x7.json
# REELS_7X7_DIR=output/reels_7x7
# UPLOAD_YT_7X7_TIMES=10:00,14:00,20:00
# YOUTUBE_7X7_PRIVACY_STATUS=public
# AUDIO_DIR_7X7=output/audio_7x7
# OAuth: ./venv/bin/python -m uploader.main youtube-oauth --channel 7x7
# Проверка: ./venv/bin/python -m uploader.main youtube-whoami --channel 7x7

# --- Threads replies under our own posts (@grishkoff_travel) ---
# THREADS_REPLIES_ENABLED=1
# THREADS_REPLIES_DRY_RUN=0
# THREADS_REPLIES_LOOKBACK_HOURS=72
# THREADS_REPLIES_MAX_PER_TICK=2
# THREADS_REPLIES_MAX_PER_POST=1
# THREADS_REPLIES_MAX_PER_DAY=8
# THREADS_REPLIES_MIN_LETTERS=8
# THREADS_REPLIES_META_INDEX=2
# THREADS_REPLIES_DB=output/threads_replies.sqlite3

# --- YouTube comment auto-reply (yt-comments) ---
# YT_COMMENTS_DRY_RUN=1
# YT_COMMENTS_INTERVAL_SEC=1800
# YT_COMMENTS_MAX_VIDEOS=20
# YT_COMMENTS_MAX_REPLIES_PER_TICK=5
# YT_COMMENTS_MIN_LETTERS=8
# YT_COMMENTS_TOKEN_PATH=youtube_shorts_uploader/token_comments.json
# YT_COMMENTS_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# YT_OAUTH_PROMPT=select_account
# YT_OAUTH_LOGIN_HINT=owner@gmail.com
#
# Обязательный финальный блок к каждому ответу (после текста от ИИ).
# Плейсхолдеры: {youtube} из BRAND_YOUTUBE, {telegram} из BRAND_TELEGRAM.
# Если не задано — используется текст по умолчанию в коде.
# YT_COMMENTS_REPLY_FOOTER=На главной канала в закрепе — пост с посланием и ссылкой. Профиль: {youtube}. Лично: {telegram} (@grishkoff).
# Максимальная длина всего комментария (основной текст + хвост), по умолчанию 900.
# YT_COMMENTS_MAX_REPLY_CHARS=900

# Jay Shambo Threads author/commentator (Notion server spec)
# THREADS_AVATAR_ID=24c2a891-8d11-4bdc-8bdf-3bc844607a36
# THREADS_AVATAR_PATH=/absolute/path/to/avatar.md
# THREADS_PRODUCTS_PATH=uploader/data/threads_products.json
# THREADS_TEXT_MAX_PER_DAY=5
# THREADS_TEXT_WINDOWS=08:00-09:15,10:30-11:45,13:00-14:30,16:00-17:30,19:00-21:00
# THREADS_TEXT_INDIA_TOUR_URL=https://jayshambo.com/tours/dusha-indii-tam-gde-ostanavlivaetsya-vremya
# THREADS_TEXT_MAX_CHARS=260
