# ===========================================
# Content Engine Configuration
# ===========================================

# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Metricool API
METRICOOL_API_TOKEN=your-metricool-token
METRICOOL_USER_ID=your-user-id

# Replicate (Flux/Stability) API
REPLICATE_API_TOKEN=your-replicate-token

# Database paths
CHROMADB_PATH=./data/chromadb
KNOWLEDGE_DIR=./knowledge

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/content_engine.log

# Content Settings
DEFAULT_PLATFORMS=instagram,pinterest,telegram
CONTENT_LANGUAGE=en
BRAND_NAME=YourBrand

# Image Generation
IMAGE_MODEL=black-forest-labs/flux-1.1-pro
DEFAULT_IMAGE_STYLE=photorealistic, cinematic lighting, 8k quality

# Scheduling
TIMEZONE=UTC
AUTO_SCHEDULE=true
