# ==========================================
# 🚗 ПРОЕКТ: LEXUS (ukraine_cars, БД telegram_promotion_lexus)
# ==========================================
# Часовой пояс: Europe/Kiev. Cron выполняется в локальном времени сервера.
# Если сервер в UTC — замените часы: 08:00 Киев = 06:00 UTC (зима) / 05:00 UTC (лето).
#
# Чтобы постинг шёл только из cron (без встроенного шедулера в контейнере),
# в docker-compose.lexus.yml для lexus-marketer замените command на:
#   command: ["sleep", "infinity"]
# Затем: docker-compose -f docker-compose.lexus.yml up -d lexus-marketer
# ==========================================

# 1. Разведка (Scout) — поиск новых групп, каждые 6 часов в :00
0 */6 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec lexus-account-manager python3 /app/services/account-manager/scout.py ukraine_cars >> logs/lexus_scout_cron.log 2>&1

# 2. Вступление (Smart Joiner) — вступление в группы со status=new, каждые 2 часа в :15
15 */2 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec lexus-account-manager python3 /app/services/account-manager/smart_joiner.py ukraine_cars 5 >> logs/lexus_joiner_cron.log 2>&1

# 3. Постинг (Marketer) — слоты по Киеву: 08:00, 12:00, 15:00, 18:00, 20:00
0 8,12,15,18,20 * * * cd /home/tovgrishkoff/PIAR/telegram_promotion_system_bali && docker exec lexus-marketer python3 /app/services/marketer/main.py ukraine_cars 5 >> logs/lexus_poster_cron.log 2>&1

# Установка: crontab /home/tovgrishkoff/PIAR/telegram_promotion_system_bali/crontab.lexus
# Проверка:  crontab -l
